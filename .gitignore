# Dependencies
node_modules/

# Environment — never commit real credentials
.env
.env.local
.env.*.local

# Build output
dist/
build/
.vite/

# Bun
bun.lockb

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Supabase local (if added later)
supabase/.temp/
.vercel

# A literal ${HOME} directory. Tooling that reads an unexpanded "${HOME}/..."
# path treats it as RELATIVE and creates this folder under the current working
# directory, filling it with private assistant memory. packages/db and apps/web
# already had local rules; this root rule covers any future package.
${HOME}/
